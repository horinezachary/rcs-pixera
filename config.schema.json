{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "directors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "host": { "type": "string", "minLength": 1, "maxLength": 253 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "label": { "type": "string", "maxLength": 40 }
        },
        "required": ["id", "host", "port", "label"],
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "fpsDropWarnPercent": { "type": "number", "minimum": 1, "maximum": 50 },
        "gpuTempWarnC": { "type": "number", "minimum": 40, "maximum": 110 },
        "gpuTempCritC": { "type": "number", "minimum": 40, "maximum": 120 },
        "unreachableAfterPolls": { "type": "number", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "scanPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "allowControls": { "type": "boolean" }
  },
  "required": ["directors", "thresholds", "allowControls"],
  "additionalProperties": false
}
